---
import Clock from './Clock';
---
<footer class="relative pb-20 md:pb-0 border-t border-cream/10 bg-ink/85 backdrop-blur-md">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-2xl font-extralight uppercase tracking-tight">Afolabi Peter</p>
      <p class="mt-3 max-w-sm text-sm text-cream/60">Junior Full-Stack Engineer. I build software people trust with money and data.</p>
      <p class="mt-5 flex items-center gap-2.5 text-sm"><span class="size-2 rounded-full bg-teal shadow-[0_0_0_4px_rgba(61,224,197,.2)]"></span>Open to remote roles and internships</p>
      <p class="mt-2"><Clock client:idle /></p>
    </div>
    <nav aria-label="Footer">
      <p class="eyebrow mb-4 !text-teal">Navigate</p>
      <ul class="space-y-2.5 text-cream/80">
        <li><a class="hover:text-accent" href="/work/">Projects</a></li>
        <li><a class="hover:text-accent" href="/#about">About</a></li>
        <li><a class="hover:text-accent" href="/#experience">Experience</a></li>
        <li><a class="hover:text-accent" href="/#contact">Contact</a></li>
      </ul>
