      <ul class="space-y-2.5 text-cream/80">
        <li><a class="hover:text-accent" href="https://github.com/peterafolabi-dev" target="_blank" rel="noopener">GitHub ↗</a></li>
        <li><a class="hover:text-accent" href="https://www.linkedin.com/in/afolabi-peter-953669391" target="_blank" rel="noopener">LinkedIn ↗</a></li>
        <li><a class="hover:text-accent" href="/Afolabi-Peter-CV.pdf" download>Download CV ↓</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex items-center justify-between border-t border-cream/10 py-6 font-mono text-[11px] uppercase tracking-widest text-cream/50">
    <span>© 2026 Afolabi Peter</span><a class="hover:text-accent" href="#top">Back to top ↑</a>
  </div>
</footer>
