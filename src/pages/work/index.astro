---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
---
<Base title="Projects — Afolabi Peter" description="Six real projects by Afolabi Peter: fintech, marketplace, e-commerce, edtech and logistics, each with a live demo and code.">
<section class="wrap pb-20 pt-32 sm:pt-40">
  <p class="mb-5 inline-block rounded-md bg-cream/10 px-3 py-1 text-sm text-cream/80">I love building things</p>
  <p class="eyebrow mb-4">Selected work · {projects.length} projects</p>
  <h1 class="text-[clamp(3.2rem,12vw,9rem)] font-extralight uppercase leading-[.92] tracking-[-0.04em]">Projects</h1>
  <p class="mt-6 max-w-xl text-base text-cream/65 sm:text-lg">Six real, shipped projects across fintech, marketplaces, e-commerce, edtech and logistics. Each one has a live demo, the code on GitHub, and a short case study.</p>

  <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((p, i) => (
      <li data-r>
        <a href={`/work/${p.slug}/`} class="group card block h-full overflow-hidden p-2.5 transition duration-500 hover:-translate-y-1.5 hover:border-accent/60">
          <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-slate"><img src={p.img} alt={`${p.title} screenshot`} loading="lazy" class="size-full object-cover transition duration-700 group-hover:scale-105" /></div>
          <div class="px-2 pb-2 pt-4">
            <div class="flex items-baseline justify-between gap-3"><h2 class="text-xl font-light tracking-tight group-hover:text-accent">{p.title}</h2><span class="font-mono text-[11px] text-cream/50">0{i + 1} · {p.year}</span></div>
            <p class="mt-1 text-sm text-cream/60">{p.kind}</p>
            <p class="mt-3 line-clamp-3 text-sm text-cream/70">{p.summary}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">{p.stack.slice(0, 4).map((s) => <span class="rounded-full border border-cream/12 px-2.5 py-1 font-mono text-[10.5px] text-cream/70">{s}</span>)}</div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
</Base>
