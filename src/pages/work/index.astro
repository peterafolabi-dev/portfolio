---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import CodePeek from '../../components/CodePeek';
import { peeks } from '../../data/peeks';
---
<Base title="Projects — Afolabi Peter" description="Six real projects by Afolabi Peter: fintech, marketplace, e-commerce, edtech and logistics, each with a live demo and code.">
<section class="wrap pb-20 pt-32 sm:pt-40">
  <p class="mb-5 inline-block rounded-md bg-cream/10 px-3 py-1 text-sm text-cream/92">I love building things</p>
  <p class="eyebrow mb-4">Selected work · {projects.length} projects</p>
  <h1 class="text-[clamp(3.2rem,12vw,9rem)] font-extralight uppercase leading-[.92] tracking-[-0.04em]">Projects</h1>
  <p class="mt-6 max-w-xl text-base text-cream/90 sm:text-lg">Six real, shipped projects across fintech, marketplaces, e-commerce, edtech and logistics. Each one has a live demo, the code on GitHub, and a short case study.</p>

  <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((p, i) => (
      <li data-r>
        <div class="group card h-full overflow-hidden p-2.5 transition duration-500 hover:-translate-y-1.5 hover:border-accent/60 hover:shadow-[0_0_0_1px_rgba(255,74,28,.35),0_18px_48px_-16px_rgba(255,74,28,.35)]">
          <a href={`/work/${p.slug}/`} class="block rounded-2xl">
            <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-slate ring-1 ring-white/10"><img src={p.img} alt={`${p.title} screenshot`} loading="lazy" class="size-full object-cover transition duration-700 group-hover:scale-105" /></div>
            <div class="px-2 pb-2 pt-4">
              <div class="flex items-baseline justify-between gap-3"><h2 class="text-xl font-light tracking-tight group-hover:text-accent">{p.title}</h2><span class="font-mono text-[11px] text-cream/75">0{i + 1} · {p.year}</span></div>
              <p class="mt-1 text-sm text-cream/90">{p.kind}</p>
              <p class="mt-3 line-clamp-3 text-sm text-cream/90">{p.summary}</p>
              {p.note && <p class="mt-3 text-xs text-amber">{p.note}</p>}
              <div class="mt-4 flex flex-wrap gap-1.5">{p.stack.slice(0, 4).map((s) => <span class="rounded-full border border-white/20 px-2.5 py-1 font-mono text-[10.5px] text-cream/90">{s}</span>)}</div>
            </div>
          </a>
          {peeks[p.slug] && <div class="px-2 pb-1"><CodePeek client:visible peek={peeks[p.slug]} /></div>}
        </div>
      </li>
    ))}
  </ul>
</section>
</Base>
