---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import { cases } from '../../data/cases';
import Snippet from '../../components/Snippet.astro';
import snippets from '../../data/snippets.json';
export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
const { p, next } = Astro.props;
const c = cases[p.slug];
const snips = (snippets as Record<string, any[]>)[p.slug] ?? [];
---
<Base title={`${p.title} — Afolabi Peter`} description={p.summary}>
<article class="wrap pb-16 pt-32 sm:pt-40">
  <a href="/work/" class="font-mono text-xs uppercase tracking-widest text-cream/78 hover:text-accent">← All projects</a>
  <p class="eyebrow mt-8">Case study · {p.kind}</p>
  <h1 class="mt-3 text-[clamp(3rem,10vw,7.5rem)] font-extralight uppercase leading-[.92] tracking-[-0.04em]">{p.title}</h1>

  <div class="card mt-10 overflow-hidden p-2.5 sm:p-3">
    <img src={p.img} alt={`${p.title} screenshot`} class="aspect-[16/9] w-full rounded-2xl object-cover object-top" />
  </div>

  <dl class="mt-8 grid grid-cols-2 gap-5 border-y border-white/[.14] py-6 text-sm md:grid-cols-4">
    <div><dt class="eyebrow mb-1.5">Year</dt><dd>{p.year}</dd></div>
    <div><dt class="eyebrow mb-1.5">Stack</dt><dd>{p.stack.join(', ')}</dd></div>
    <div><dt class="eyebrow mb-1.5">Live</dt><dd><a class="text-accent hover:underline" href={p.live} target="_blank" rel="noopener">{p.liveLabel} ↗</a></dd></div>
    <div><dt class="eyebrow mb-1.5">Code</dt><dd><a class="text-accent hover:underline" href={p.repo} target="_blank" rel="noopener">GitHub ↗</a>{p.case && <> · <a class="text-accent hover:underline" href={p.case} target="_blank" rel="noopener">Case study ↗</a></>}</dd></div>
  </dl>

  {(p.note || c?.ci) && (
    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
      {c?.ci && <a href={c.ci.url} target="_blank" rel="noopener" aria-label="GitHub Actions status for this project"><img src={c.ci.badge} alt="CI status" height="20" class="h-5 w-auto" /></a>}
      {p.note && <p class="rounded-full border border-amber/40 bg-amber/10 px-3.5 py-1.5 text-amber">{p.note}</p>}
    </div>
  )}

  {c ? (
    <div class="mt-14 space-y-16">
      <section class="grid gap-6 md:grid-cols-[minmax(0,.6fr)_minmax(0,1.4fr)] md:gap-12">
        <h2 class="eyebrow !text-teal">The problem</h2>
        <div><p class="text-lg text-cream/94 sm:text-xl">{c.problem}</p><p class="mt-5 font-mono text-xs uppercase tracking-widest text-cream/70">My role: {c.role}</p></div>
      </section>

      {c.shots && (
        <section aria-label="Screens" class="grid gap-4 sm:grid-cols-2">
          {c.shots.map((s) => (
            <figure class={`card overflow-hidden p-2 ${s.mobile ? 'sm:col-span-1' : ''}`}>
              <img src={s.src} alt={s.alt} loading="lazy" class={`w-full rounded-2xl ${s.mobile ? 'mx-auto max-h-[34rem] w-auto object-contain' : ''}`} />
            </figure>
          ))}
        </section>
      )}

      {c.video && (
        <section aria-label="Walkthrough video"><video controls preload="none" playsinline poster={c.video.poster} class="w-full rounded-3xl border border-white/[.14]"><source src={c.video.src} type="video/mp4" /></video></section>
      )}

      {snips.length > 0 && (
        <section>
          <h2 class="eyebrow mb-3 !text-teal">The code behind the claims</h2>
          <p class="mb-8 max-w-2xl text-cream/78">Each claim, the exact lines that make it true (pinned to a commit so the link never drifts), and the test that proves it.</p>
          <div class="grid gap-6 lg:grid-cols-2">{snips.map((sn) => <Snippet {...sn} />)}</div>
        </section>
      )}

      <section>
        <h2 class="eyebrow mb-8 !text-teal">Decisions and why</h2>
        <ol class="divide-y divide-white/[.12] border-y border-white/[.14]">
          {c.decisions.map((d, i) => (
            <li class="grid gap-3 py-7 md:grid-cols-[4rem_minmax(0,.9fr)_minmax(0,1.4fr)] md:gap-8">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              <h3 class="text-xl font-light tracking-tight">{d.t}</h3>
              <p class="text-cream/86">{d.d}</p>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h2 class="eyebrow mb-3 !text-teal">What I got wrong</h2>
        <p class="mb-6 max-w-2xl text-cream/78">The gaps and mistakes, stated plainly, with what I did about them.</p>
        <ul class="grid gap-4 md:grid-cols-2">{c.wrong.map((w) => <li class="card p-5 text-cream/92 sm:p-6">{w}</li>)}</ul>
      </section>

      <section class="grid gap-10 md:grid-cols-2">
        <div><h2 class="eyebrow mb-4 !text-teal">Results</h2><ul class="space-y-3 text-cream/92">{c.results.map((r) => <li class="flex gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent"></span>{r}</li>)}</ul></div>
        <div><h2 class="eyebrow mb-4 !text-teal">What I’d build next</h2><ul class="space-y-3 text-cream/92">{c.next.map((r) => <li class="flex gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-teal"></span>{r}</li>)}</ul></div>
      </section>
    </div>
  ) : (
    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <section><h2 class="eyebrow mb-3 !text-teal">What it is</h2><p class="text-lg text-cream/94">{p.summary}</p></section>
      <section><h2 class="eyebrow mb-3 !text-teal">The hard part</h2><p class="text-lg text-cream/94">{p.hard}</p></section>
    </div>
  )}

  <a href={`/work/${next.slug}/`} class="group card mt-16 flex items-center justify-between gap-6 p-6 transition hover:border-accent/60 sm:p-8">
    <span><span class="eyebrow block">Next project</span><b class="mt-2 block text-2xl font-light tracking-tight group-hover:text-accent sm:text-4xl">{next.title}</b></span>
    <span class="text-3xl transition group-hover:translate-x-2">→</span>
  </a>
</article>
</Base>
