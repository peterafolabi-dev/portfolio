---
import Base from '../layouts/Base.astro';
import ProjectCarousel from '../components/ProjectCarousel';
import Dots from '../components/Dots';
import WorkIndex from '../components/WorkIndex.astro';
import { projects } from '../data/projects';

const items = projects.map((p) => ({ slug: p.slug, title: p.title, kind: p.kind, year: p.year, img: p.img, stack: p.stack }));
const caps = [
  ['Full-stack web apps', 'React, Next.js and Django front to back, deployed on real infrastructure.'],
  ['Payments & money logic', 'Server-verified Paystack payments, whole-kobo maths, ledgers that can’t be quietly edited.'],
  ['Data & constraints', 'PostgreSQL and Supabase with row-level security and rules the database enforces.'],
  ['Offline-first & PWA', 'Apps that keep working with no network and sync safely later.'],
  ['Testing & CI', 'Unit and property-based tests that run on every push.'],
  ['Clean, fast UI', 'Responsive, accessible interfaces in Tailwind that load quickly on mobile data.'],
];
const stats = [
  ['6', 'Live projects, all with code on GitHub'],
  ['800', 'Random trading histories tested on every push (Oja Ledger)'],
  ['103', 'Products in the RedCart store'],
  ['3.79', 'CGPA, Computer Engineering, FUT Minna'],
];
const steps = [
  ['01', 'Understand', 'Start with the real problem and who relies on the product, including the unhappy paths.'],
  ['02', 'Constrain', 'Put the rules in the schema and the types so bad states can’t exist.'],
  ['03', 'Build', 'Ship small, working slices on real infrastructure and keep them fast.'],
  ['04', 'Prove', 'Automated tests in CI, property-based where correctness matters most.'],
];
const tools = [
  ['Languages', ['TypeScript', 'JavaScript', 'Python']],
  ['Frontend', ['React', 'Next.js', 'Tailwind CSS']],
  ['Backend & data', ['Django', 'Supabase', 'PostgreSQL']],
] as const;
---
<Base home>
<div id="top"></div>

<section class="relative flex min-h-svh items-end pb-16 pt-32 sm:pb-24" aria-label="Introduction">
  <Dots client:idle />
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[.07] [background-image:linear-gradient(var(--color-cream)_1px,transparent_1px),linear-gradient(90deg,var(--color-cream)_1px,transparent_1px)] [background-size:64px_64px] [mask-image:linear-gradient(transparent,#000_30%,#000_70%,transparent)]"></div>
  <p aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 font-mono text-[10px] uppercase tracking-[.3em] text-cream/35 [writing-mode:vertical-rl] lg:block">Portfolio · 2026</p>
  <div class="wrap relative">
    <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-cream/15 bg-ink/50 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-[.16em] text-cream/75 backdrop-blur"><span class="size-2 rounded-full bg-teal shadow-[0_0_10px_var(--color-teal)]"></span>Open to remote roles &amp; internships</p>
    <p class="eyebrow mb-5">Junior Full-Stack Engineer · Nigeria</p>
    <h1 class="text-[clamp(3.4rem,15vw,11.5rem)] font-extralight uppercase leading-[.88] tracking-[-0.05em]">Afolabi<br /><span class="bg-gradient-to-r from-cream via-cream to-teal bg-clip-text text-transparent">Peter</span></h1>
    <div class="mt-8 grid gap-8 sm:mt-10 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="max-w-md text-base text-cream/75 sm:text-lg">I build software people trust with money and data. Based in Nigeria, open to remote roles and internships.</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {['Full-stack engineering', 'Fintech & marketplaces', 'Offline-first apps'].map((t) => <span class="rounded-full border border-cream/15 bg-ink/40 px-3 py-1 font-mono text-[10.5px] uppercase tracking-[.12em] text-cream/70 backdrop-blur">{t}</span>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#work" class="btn btn-primary">View my work ↓</a>
          <a href="/Afolabi-Peter-CV.pdf" download class="btn btn-ghost">Download CV</a>
        </div>
      </div>
      <dl class="card w-full max-w-sm p-5 font-mono text-[11px] uppercase tracking-[.1em] md:w-80">
        <p class="mb-3 text-cream/40">[ Builder profile ]</p>
        {[['Status', 'Open to work', true], ['Discipline', 'Full-stack', false], ['Focus', 'Fintech · Marketplaces', false], ['Base', 'Nigeria · Remote', false], ['Studying', 'FUT Minna · 2028', false]].map(([k, v, on]) => (
          <div class="flex justify-between gap-4 border-t border-cream/10 py-2"><dt class="text-cream/45">{k}</dt><dd class="text-right text-cream">{on && <span class="mr-1.5 inline-block size-1.5 rounded-full bg-accent"></span>}{v}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section class="py-24 sm:py-36" aria-label="Summary">
  <div class="wrap">
    <p data-r class="max-w-4xl text-3xl font-light leading-[1.15] tracking-tight sm:text-5xl lg:text-6xl">Payments verified on the server. Bookings the database refuses to double. <span class="text-accent">Software</span> you can trust.</p>
  </div>
</section>

<section id="work" class="py-16 sm:py-24">
  <div class="wrap">
    <div data-r class="mb-10 flex items-end justify-between gap-6">
      <div><p class="eyebrow mb-4"><span class="text-accent">01</span> — Selected work</p><h2 class="h2">Projects</h2></div>
      <a href="/work/" class="btn btn-ghost hidden sm:inline-flex">All projects →</a>
    </div>
  </div>
  <ProjectCarousel client:visible items={items} />
  <div class="wrap mt-16">
    <p data-r class="mb-5 font-mono text-xs uppercase tracking-[.18em] text-cream/50">Index — all work</p>
    <WorkIndex />
  </div>
</section>

<section id="capabilities" class="py-16 sm:py-24" aria-label="Capabilities">
  <div class="wrap">
    <div data-r class="mb-10 grid gap-4 md:grid-cols-2 md:items-end">
      <div><p class="eyebrow mb-4"><span class="text-accent">02</span> — Capabilities</p><h2 class="h2">How I can help</h2></div>
      <p class="text-cream/65">From first schema to deployed, tested product, these are the things I’ve actually shipped.</p>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-3xl border border-cream/10 bg-cream/10 sm:grid-cols-2 lg:grid-cols-3">
      {caps.map(([t, d], i) => (
        <li data-r class="bg-panel/90 p-6 backdrop-blur-md transition hover:bg-slate/70 sm:p-8">
          <span class="font-mono text-xs text-accent">0{i + 1}</span>
          <h3 class="mt-3 text-lg font-normal tracking-tight">{t}</h3>
          <p class="mt-2 text-sm text-cream/65">{d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="py-16 sm:py-24" aria-label="By the numbers">
  <div class="wrap">
    <div data-r class="card grid grid-cols-2 overflow-hidden lg:grid-cols-4">
      {stats.map(([n, l], i) => (
        <div class={`p-6 sm:p-8 ${i % 2 === 0 ? 'border-r border-cream/10' : ''} ${i < 2 ? 'border-b border-cream/10 lg:border-b-0' : ''} ${i === 1 ? 'lg:border-r' : ''}`}>
          <p class="bg-gradient-to-r from-accent via-amber to-teal bg-clip-text text-5xl font-extralight tracking-tighter text-transparent sm:text-7xl">{n}</p>
          <p class="mt-3 text-xs text-cream/60 sm:text-sm">{l}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="about" class="py-16 sm:py-24">
  <div class="wrap grid items-center gap-10 md:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] md:gap-16">
    <div data-r class="mx-auto w-full max-w-sm md:mx-0">
      <div class="aspect-[3/4] overflow-hidden rounded-3xl border border-cream/10 bg-slate shadow-[10px_10px_0_var(--color-accent)]">
        <img src="/img/portrait.jpg" alt="Portrait of Afolabi Peter" loading="lazy" class="size-full object-cover" />
      </div>
    </div>
    <div data-r>
      <p class="eyebrow mb-4"><span class="text-accent">03</span> — About</p>
      <h2 class="h2 mb-8">About me</h2>
      <p class="text-base text-cream/80 sm:text-lg">I’m a Computer Engineering student at the Federal University of Technology, Minna, and a Junior Full-Stack Engineer who learns by shipping. I like the unglamorous layer: database constraints, payment verification, offline behaviour and tests that fail loudly.</p>
      <p class="mt-6 text-2xl font-extralight leading-tight tracking-tight sm:text-4xl">Correctness is a feature you <span class="text-accent">can’t bolt on later.</span></p>
      <ul class="mt-8 flex flex-wrap gap-2.5 text-sm">
        <li class="rounded-full border border-teal/60 px-4 py-2 text-teal">Open to remote roles</li>
        <li class="rounded-full border border-cream/15 px-4 py-2">Internships</li>
        <li class="rounded-full border border-cream/15 px-4 py-2">Based in Nigeria</li>
      </ul>
      <p class="mt-6 font-mono text-xs uppercase tracking-widest text-cream/50">B.Eng. Computer Engineering · FUT Minna · 2024–2028</p>
    </div>
  </div>
</section>

<section id="approach" class="py-16 sm:py-24">
  <div class="wrap">
    <div data-r><p class="eyebrow mb-4"><span class="text-accent">04</span> — Approach</p><h2 class="h2 mb-10">How I work</h2></div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map(([n, t, d]) => (
        <div data-r class="card p-6 transition duration-300 hover:-translate-y-1 hover:border-accent/50">
          <span class="font-mono text-xs text-accent">{n}</span>
          <h3 class="mb-2 mt-4 text-2xl font-light tracking-tight">{t}</h3>
          <p class="text-sm text-cream/65">{d}</p>
        </div>
      ))}
    </div>
    <div data-r class="mt-14">
      <p class="eyebrow mb-5">Toolkit</p>
      <div class="grid gap-4 md:grid-cols-3">
        {tools.map(([name, list]) => (
          <div class="card p-6">
            <h3 class="mb-4 font-mono text-xs uppercase tracking-widest text-teal">{name}</h3>
            <ul class="flex flex-wrap gap-2">{list.map((t) => <li class="rounded-full border border-cream/15 px-3.5 py-1.5 text-sm">{t}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="contact" class="py-16 sm:py-24">
  <div class="wrap">
    <div data-r class="rounded-[2rem] bg-accent p-8 text-ink sm:p-14">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ink/70">Contact</p>
      <h2 class="mt-4 text-[clamp(3rem,11vw,8rem)] font-extralight uppercase leading-[.9] tracking-tighter">Let’s talk!</h2>
      <a href="mailto:afolabiprosper329@gmail.com" class="mt-8 block break-all text-xl font-light tracking-tight underline-offset-8 hover:underline sm:text-4xl">afolabiprosper329@gmail.com</a>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/Afolabi-Peter-CV.pdf" download class="btn border border-ink hover:bg-ink hover:text-cream">Download CV ↓</a>
        <a href="https://www.linkedin.com/in/afolabi-peter-953669391" target="_blank" rel="noopener" class="btn border border-ink hover:bg-ink hover:text-cream">LinkedIn ↗</a>
        <a href="https://github.com/peterafolabi-dev" target="_blank" rel="noopener" class="btn border border-ink hover:bg-ink hover:text-cream">GitHub ↗</a>
      </div>
    </div>
  </div>
</section>
</Base>
