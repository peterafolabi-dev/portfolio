---
import Base from '../layouts/Base.astro';
import ProjectCarousel from '../components/ProjectCarousel';
import Dots from '../components/Dots';
import TamperDemo from '../components/TamperDemo';
import { cases } from '../data/cases';
import { peeks } from '../data/peeks';
import WorkIndex from '../components/WorkIndex.astro';
import { projects } from '../data/projects';

const items = projects.map((p) => ({ slug: p.slug, title: p.title, kind: p.kind, year: p.year, img: p.img, stack: p.stack, peek: peeks[p.slug] }));
const caps = [
  ['Full-stack web apps', 'React, Next.js and Django front to back, deployed on real infrastructure.'],
  ['Payments & money logic', 'Server-verified Paystack payments, whole-kobo maths, ledgers that can’t be quietly edited.'],
  ['Data & constraints', 'PostgreSQL and Supabase with row-level security and rules the database enforces.'],
  ['Offline-first & PWA', 'Apps that keep working with no network and sync safely later.'],
  ['Testing & CI', 'Unit and property-based tests that run on every push.'],
  ['Clean, fast UI', 'Responsive, accessible interfaces in Tailwind that load quickly on mobile data.'],
];
const jobs = [
  { role: 'Software Engineering Intern', org: 'MALhub', where: 'Ilorin · On-site · Industrial training', when: 'Aug – Oct 2026', pts: [
    'Built Travel & Stays, a booking marketplace for stays and tours with guest, host and tour-guide roles, in React and Supabase.',
    'Made double bookings impossible with a PostgreSQL exclusion constraint on booking dates instead of checks in application code.',
    'Integrated Paystack with server-side verification of the exact amount and currency before a booking is marked paid, covered by 11 unit tests in CI.',
  ] },
  { role: 'Customer Support & Sales Assistant', org: 'Tools by FK', where: 'Remote · Part-time', when: 'Jul 2026 – now', pts: [
    'Advise students and professionals on AI and digital tools, and manage orders, subscription activations and account access end to end.',
  ] },
];
const stats = [
  ['6', 'Live projects, all with code on GitHub'],
  ['4 × 200', 'Ledger invariants, each checked on 200 generated ledgers on every push (Oja Ledger)'],
  ['11', 'Unit tests on the Paystack payment decision, down to one kobo (Travel & Stays)'],
];
const tools = [
  ['Languages', ['TypeScript', 'JavaScript', 'Python']],
  ['Frontend', ['React', 'Next.js', 'Tailwind CSS']],
  ['Backend & data', ['Django', 'Supabase', 'PostgreSQL']],
] as const;
import LiveTime from '../components/LiveTime';
import BuildClock from '../components/BuildClock';
---
<Base home>
<div id="top"></div>

<section class="relative flex min-h-svh items-end pb-16 pt-32 sm:pb-24" aria-label="Introduction">
  <Dots client:idle />
  <div class="wrap relative">
    <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/[.22] bg-ink/50 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-[.16em] text-cream/90 backdrop-blur"><span class="size-2 rounded-full bg-teal shadow-[0_0_10px_var(--color-teal)]"></span>Open to remote roles &amp; internships</p>
    <p class="eyebrow mb-5">Junior Full-Stack Engineer · Nigeria</p>
    <h1 class="text-[clamp(3rem,9vw,7.5rem)] font-semibold leading-[.92] tracking-[-0.055em]">Afolabi<br /><span class="bg-gradient-to-r from-cream via-cream to-teal bg-clip-text text-transparent">Peter</span></h1>
    <div class="mt-8 grid gap-8 sm:mt-10 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="max-w-md text-base text-cream/90 sm:text-lg">I build money-handling software: an offline ledger that catches a changed naira, bookings the database refuses to double, payments the server confirms. Based in Nigeria, open to remote roles and internships.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#work" class="btn btn-primary">View my work ↓</a>
          <a href="/Afolabi-Peter-CV.pdf" download class="btn btn-ghost">Download CV</a>
        </div>
      </div>
      <dl class="card w-full max-w-sm p-5 font-mono text-[11px] uppercase tracking-[.1em] md:w-80">
        <p class="mb-3 text-cream/75">[ Builder profile ]</p>
        {[['Status', 'Open to work', true], ['Discipline', 'Full-stack', false], ['Focus', 'Fintech · Marketplaces', false], ['Base', 'Nigeria · Remote', false], ['Studying', 'FUT Minna · 2028', false]].map(([k, v, on]) => (
          <div class="flex justify-between gap-4 border-t border-white/[.14] py-2"><dt class="text-cream/75">{k}</dt><dd class="text-right text-cream">{on && <span class="mr-1.5 inline-block size-1.5 rounded-full bg-accent"></span>}{v}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section aria-label="Live clocks" class="pb-10 sm:pb-14">
  <div class="wrap">
    <div data-r class="card grid grid-cols-1 divide-y divide-white/[.14] overflow-hidden sm:grid-cols-2 sm:divide-x sm:divide-y-0">
      <div class="p-6 sm:p-8">
        <p class="eyebrow mb-3">Local time · Lagos</p>
        <p class="font-mono text-2xl font-medium tracking-tight text-white sm:text-4xl"><LiveTime client:load /></p>
        <p class="mt-3 text-xs text-cream/90 sm:text-sm">Where I am working from, right now</p>
      </div>
      <div class="p-6 sm:p-8">
        <p class="eyebrow mb-3">Building since Dec 2025</p>
        <p class="bg-gradient-to-r from-accent via-amber to-teal bg-clip-text font-mono text-2xl font-medium tracking-tight text-transparent sm:text-4xl"><BuildClock client:load /></p>
        <p class="mt-3 text-xs text-cream/90 sm:text-sm">Counting up since I started building RedCart</p>
      </div>
    </div>
  </div>
</section>

<section class="py-12 sm:py-16" aria-label="Summary">
  <div class="wrap">
    <p data-r class="max-w-4xl text-2xl font-medium leading-[1.2] tracking-tight sm:text-3xl lg:text-4xl">My first property test caught a bug in <span class="text-accent">my own test</span>. That is why I write them first.</p>
  </div>
</section>

<section id="flagship" class="py-12 sm:py-16" aria-label="Flagship project">
  <div class="wrap">
    <div data-r class="mb-10 grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end">
      <div><p class="eyebrow mb-4"><span class="text-accent">01</span> — Flagship</p><h2 class="h2">Oja Ledger</h2></div>
      <p class="text-lg text-cream/90">Offline bookkeeping for Nigerian traders, where changing a single naira in the past is detectable. Built alone: accounting engine, tests, UI and deployment.</p>
    </div>
    <div data-r class="mb-6 grid gap-4 sm:grid-cols-3">
      {[['4 × 200', 'invariants × generated ledgers, per push'], ['0 floats', 'money is whole kobo behind a branded type'], ['Offline', 'works with no network; each save is one atomic transaction']].map(([n, l]) => (
        <div class="card p-5"><p data-num class="bg-gradient-to-r from-accent to-amber bg-clip-text text-2xl font-semibold tracking-tight text-transparent sm:text-3xl">{n}</p><p class="mt-2 text-xs text-cream/90">{l}</p></div>
      ))}
    </div>
    <div data-r class="mb-6">
      <p class="mx-auto mb-3 max-w-3xl font-mono text-xs uppercase tracking-[.18em] text-teal">40-second tour, recorded from the app with the network switched off</p>
      <video controls preload="none" playsinline poster="/img/oja-tour-poster.jpg" class="mx-auto aspect-video w-full max-w-3xl rounded-3xl border border-white/[.14] bg-black shadow-[0_18px_48px_-18px_rgba(0,0,0,.9)]"><source src="/video/oja-ledger-tour.mp4" type="video/mp4" /></video>
    </div>
    <div data-r>
      <p class="mb-3 font-mono text-xs uppercase tracking-[.18em] text-teal">Try to break it</p>
      <TamperDemo client:visible />
    </div>
    <div data-r class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/work/oja-ledger/" class="btn btn-primary">Read the case study →</a>
      <a href="https://oja-ledger.vercel.app" target="_blank" rel="noopener" class="btn btn-ghost">Live demo ↗</a>
      <a href="https://github.com/peterafolabi-dev/oja-ledger" target="_blank" rel="noopener" class="btn btn-ghost">Code ↗</a>
    </div>
  </div>
</section>

<section id="work" class="py-12 sm:py-16">
  <div class="wrap">
    <div data-r class="mb-10 flex items-end justify-between gap-6">
      <div><p class="eyebrow mb-4"><span class="text-accent">02</span> — Also built</p><h2 class="h2">More projects</h2></div>
      <a href="/work/" class="btn btn-ghost hidden sm:inline-flex">All projects →</a>
    </div>
  </div>
  <ProjectCarousel client:visible items={items} />
  <div class="wrap mt-16">
    <p data-r class="mb-5 font-mono text-xs uppercase tracking-[.18em] text-cream/75">Index — all work</p>
    <WorkIndex />
  </div>
</section>

<section id="capabilities" class="py-12 sm:py-16" aria-label="Capabilities">
  <div class="wrap">
    <div data-r class="mb-10 grid gap-4 md:grid-cols-2 md:items-end">
      <div><p class="eyebrow mb-4"><span class="text-accent">03</span> — Capabilities</p><h2 class="h2">How I can help</h2></div>
      <p class="text-cream/90">From first schema to deployed, tested product, these are the things I’ve actually shipped.</p>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-3xl border border-white/[.14] bg-cream/10 sm:grid-cols-2 lg:grid-cols-3">
      {caps.map(([t, d], i) => (
        <li data-r class="bg-panel/90 p-6 backdrop-blur-md transition hover:bg-slate/70 sm:p-8">
          <span class="font-mono text-xs text-accent">0{i + 1}</span>
          <h3 class="mt-3 text-lg font-normal tracking-tight">{t}</h3>
          <p class="mt-2 text-sm text-cream/90">{d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="py-12 sm:py-16" aria-label="By the numbers">
  <div class="wrap">
    <div data-r class="card grid grid-cols-1 overflow-hidden sm:grid-cols-3">
      {stats.map(([n, l], i) => (
        <div class={`p-6 sm:p-8 ${i < 2 ? 'border-b border-white/[.14] sm:border-b-0 sm:border-r' : ''}`}>
          <p data-num class="bg-gradient-to-r from-accent via-amber to-teal bg-clip-text text-4xl font-semibold tracking-tighter text-transparent sm:text-5xl">{n}</p>
          <p class="mt-3 text-xs text-cream/90 sm:text-sm">{l}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="experience" class="py-12 sm:py-16" aria-label="Experience">
  <div class="wrap">
    <div data-r class="mb-10"><p class="eyebrow mb-4"><span class="text-accent">04</span> — Experience</p><h2 class="h2">Where I’ve worked</h2></div>
    <ol class="space-y-5">
      {jobs.map((j, i) => (
        <li data-r style={`--st:${6 + i * 1.25}rem`} class="card grid gap-5 p-6 sm:p-8 md:sticky md:top-(--st) md:bg-panel md:grid-cols-[minmax(0,.8fr)_minmax(0,1.6fr)] md:gap-12">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-accent">{j.when}</p>
            <h3 class="mt-3 text-2xl font-medium tracking-tight">{j.role}</h3>
            <p class="mt-1 text-cream/90">{j.org}</p>
            <p class="mt-1 text-sm text-cream/75">{j.where}</p>
          </div>
          <ul class="space-y-3 text-cream/90">{j.pts.map((t) => <li class="flex gap-3"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-teal"></span>{t}</li>)}</ul>
        </li>
      ))}
      <li data-r style="--st:8.5rem" class="card flex flex-col gap-2 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8 md:sticky md:top-(--st) md:bg-panel">
        <div><p class="font-mono text-xs uppercase tracking-widest text-accent">2024 – 2028</p><h3 class="mt-2 text-xl font-medium tracking-tight">B.Eng. Computer Engineering, FUT Minna</h3></div>
        <p class="text-sm text-cream/90">CGPA 3.79/5.00 · Frontend Development certificate, MALhub (Oct 2026)</p>
      </li>
    </ol>
  </div>
</section>

<section id="about" class="py-12 sm:py-16">
  <div class="wrap grid items-center gap-10 md:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] md:gap-16">
    <div data-r class="relative z-10 mx-auto w-full max-w-[20rem] sm:max-w-sm md:mx-0">
      <div class="aspect-[3/4] w-full overflow-hidden rounded-3xl border border-white/[.14] bg-slate shadow-[10px_10px_0_var(--color-accent)]">
        <img src="/img/portrait.jpg" alt="Portrait of Afolabi Peter" loading="lazy" class="size-full object-cover contrast-[1.08] saturate-[1.12] brightness-[1.04]" />
      </div>
    </div>
    <div data-r>
      <p class="eyebrow mb-4"><span class="text-accent">05</span> — About</p>
      <h2 class="h2 mb-8">About me</h2>
      <p class="text-base text-cream/92 sm:text-lg">I’m a Computer Engineering student at the Federal University of Technology, Minna, and a Junior Full-Stack Engineer who learns by shipping. I like the unglamorous layer: database constraints, payment verification, offline behaviour and tests that fail loudly.</p>
      <p class="mt-6 text-xl font-semibold leading-tight tracking-tight sm:text-3xl">Correctness is a feature you <span class="text-accent">can’t bolt on later.</span></p>
      <ul class="mt-8 flex flex-wrap gap-2.5 text-sm">
        <li class="rounded-full border border-teal/60 px-4 py-2 text-teal">Open to remote roles</li>
        <li class="rounded-full border border-white/[.22] px-4 py-2">Internships</li>
        <li class="rounded-full border border-white/[.22] px-4 py-2">Based in Nigeria</li>
      </ul>
      <p class="mt-6 font-mono text-xs uppercase tracking-widest text-cream/75">B.Eng. Computer Engineering · FUT Minna · 2024–2028</p>
    </div>
  </div>
</section>

<section id="toolkit" class="py-12 sm:py-16" aria-label="Toolkit">
  <div class="wrap">
    <div data-r>
      <p class="eyebrow mb-5"><span class="text-accent">06</span> — Toolkit</p>
      <div class="grid gap-4 md:grid-cols-3">
        {tools.map(([name, list]) => (
          <div class="card p-6">
            <h3 class="mb-4 font-mono text-xs uppercase tracking-widest text-teal">{name}</h3>
            <ul class="flex flex-wrap gap-2">{list.map((t) => <li class="rounded-full border border-white/[.22] px-3.5 py-1.5 text-sm">{t}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="contact" class="py-12 sm:py-16">
  <div class="wrap">
    <div data-r class="rounded-[2rem] bg-accent p-8 text-ink sm:p-14">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-ink/85">Contact</p>
      <h2 class="mt-4 text-[clamp(2.5rem,7vw,5rem)] font-semibold leading-[.9] tracking-tighter">Let’s talk!</h2>
      <a href="mailto:afolabiprosper329@gmail.com?subject=Role%20or%20interview%3A%20Afolabi%20Peter" class="mt-8 block break-all text-xl font-medium tracking-tight underline-offset-8 hover:underline sm:text-4xl">afolabiprosper329@gmail.com</a>
      <dl class="mt-10 grid gap-x-8 gap-y-4 border-t border-ink/25 pt-8 text-sm sm:grid-cols-2 lg:grid-cols-4">
        {[['Looking for', 'Remote roles and internships'], ['Timezone', 'WAT (UTC+1): overlaps the UK and EU workday and US mornings'], ['Stack', 'TypeScript, React, Django, PostgreSQL'], ['Best way to reach me', 'Email, or LinkedIn']].map(([k, v]) => (
          <div><dt class="font-mono text-[11px] uppercase tracking-widest text-ink/80">{k}</dt><dd class="mt-1.5 text-ink">{v}</dd></div>
        ))}
      </dl>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/Afolabi-Peter-CV.pdf" download class="btn border border-ink hover:bg-ink hover:text-cream">Download CV ↓</a>
        <a href="https://www.linkedin.com/in/afolabi-peter-953669391" target="_blank" rel="noopener" class="btn border border-ink hover:bg-ink hover:text-cream">LinkedIn ↗</a>
        <a href="https://github.com/peterafolabi-dev" target="_blank" rel="noopener" class="btn border border-ink hover:bg-ink hover:text-cream">GitHub ↗</a>
      </div>
    </div>
  </div>
</section>
</Base>
